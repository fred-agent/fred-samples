# Copy to config/.env and adjust. A deployed pod gets these from its Deployment
# spec; this file is the local-development stand-in, and the Makefile exports it
# before starting the image — the SDK itself only reads the process environment.

# Control Plane, including its API prefix.
FRED_CONTROL_PLANE_URL="http://localhost:8222/control-plane/v1"

# Knowledge Flow, including its API prefix. Only a Knowledge Base that ingests
# through Fred needs it; one that keeps its own store leaves it unset and the
# boundary logs instead.
FRED_KNOWLEDGE_FLOW_URL="http://localhost:8111/knowledge-flow/v1"

# The library documents land in. Fred will create it with the instance and put
# its id in the run context; until then, name one you created in the UI.
FRED_KB_LIBRARY_ID=""

# The dotted prefix this image owns. Every name it publishes lives under it,
# so this Knowledge Base is fred.samples.local-folder. Fred claims the prefix
# for the client below on the first publication, and the client is named after
# the prefix because that is what it owns — never after one Knowledge Base.
FRED_KB_PREFIX="fred.samples"
FRED_KB_CLIENT_ID="kb-fred.samples"
FRED_KB_CLIENT_SECRET="Azerty123_" # pragma: allowlist secret (local dev only)
FRED_KEYCLOAK_REALM_URL="http://localhost:8080/realms/app"

# Only `run` needs this; `publish` does not.
FRED_TEMPORAL_HOST="localhost:7233"
