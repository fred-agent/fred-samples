# Copy to config/.env and adjust. A deployed pod gets these from its Deployment
# spec; this file is the local-development stand-in, and the Makefile exports it
# before starting the image — the SDK itself only reads the process environment.

# Control Plane, including its API prefix.
FRED_CONTROL_PLANE_URL="http://localhost:8222/control-plane/v1"

# The namespace this image owns in Fred's catalog. Every Knowledge Base it
# publishes lives under it, so this one is kb__fred-samples__local-folder.
# Fred binds the provider — not the definition — to the client below on the
# first publication, which is why the client is named after the namespace
# rather than after one of the Knowledge Bases in it.
FRED_KB_PROVIDER_ID="fred-samples"
FRED_KB_CLIENT_ID="knowledge-base-fred-samples"
FRED_KB_CLIENT_SECRET="Azerty123_" # pragma: allowlist secret (local dev only)
FRED_KEYCLOAK_REALM_URL="http://localhost:8080/realms/app"

# Only `run` needs this; `publish` does not.
FRED_TEMPORAL_HOST="localhost:7233"
