# Copy to config/.env. Secrets only — everything else is in configuration.yaml,
# exactly as it is for every other Fred component. A deployed pod gets this from
# a Secret and the YAML from a ConfigMap.

# Which configuration this pod reads. The Makefile passes $ENV_FILE; this points
# at the rest.
CONFIG_FILE="./config/configuration.yaml"

# The confidential client's secret. Its variable name is not fixed by the SDK —
# configuration.yaml's `security.m2m.secret_env_var` chooses it.
FRED_KB_CLIENT_SECRET="Azerty123_" # pragma: allowlist secret (local dev only)

# Only the developer tool reads this: the library `make sync` writes into when
# you do not pass one on the command line.
FRED_KB_LIBRARY_ID=""

# Where this pod's ledgers live — one JSON file per Knowledge Base instance,
# recording what the last run published. Leave it empty for the default, which
# is already outside this repository:
#
#     ${XDG_STATE_HOME:-~/.local/state}/fred-samples-local-folder-kb/
#
# A deployed pod points it at a volume. NEVER point it inside this repository:
# it is per-machine, per-instance state that means nothing on another checkout,
# and a ledger committed by accident makes the next run believe the library
# already holds documents it does not.
FRED_SAMPLES_KB_STATE_DIR=""
