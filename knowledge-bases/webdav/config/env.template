# Copy to config/.env and adjust. A deployed pod gets these from its Deployment
# spec; this file is the local-development stand-in, and the Makefile exports it
# before starting the image — the SDK itself only reads the process environment.

# Control Plane, including its API prefix.
FRED_CONTROL_PLANE_URL="http://localhost:8222/control-plane/v1"

# Knowledge Flow, including its API prefix. Documents go through its
# synchronizing ingestion surface; leave it unset and the run logs what it
# would write instead, which is how `make sync` works with no Fred at all.
FRED_KNOWLEDGE_FLOW_URL="http://localhost:8111/knowledge-flow/v1"

# The dotted prefix this image owns. Every name it publishes lives under it,
# so this Knowledge Base is fred.samples.webdav. Fred claims the prefix for the
# client below on the first publication, and the client is named after the
# prefix because that is what it owns — never after one Knowledge Base.
FRED_KB_PREFIX="fred.samples"
FRED_KB_CLIENT_ID="kb-fred.samples"
FRED_KB_CLIENT_SECRET="Azerty123_" # pragma: allowlist secret (local dev only)
FRED_KEYCLOAK_REALM_URL="http://localhost:8080/realms/app"

# Only `run` needs this; `publish` does not.
FRED_TEMPORAL_HOST="localhost:7233"

# Where the per-instance ledgers live. A deployed pod points this at a volume.
# Losing it costs one run that republishes everything and removes nothing,
# never correctness — it is a cache, not a source of truth.
FRED_SAMPLES_WEBDAV_STATE_DIR=""

# How a share behind a private certificate authority is trusted: the authority's
# own certificate, in PEM. This is the right answer for a corporate host whose
# name no public authority can certify — far better than the instance's
# "Accept any certificate" box, which protects nothing.
#
# It is ADDED to what this pod already trusts. Do not use $SSL_CERT_FILE for
# this: that variable replaces the whole trust store, so a single corporate
# root in it stops this pod trusting the authorities its own Keycloak, Control
# Plane and Knowledge Flow may present.
#
# In a cluster, put the PEM in a ConfigMap — a root certificate is public, it is
# not a Secret — mount it, and point this at the mount path.
# FRED_SAMPLES_WEBDAV_CA_FILE="/etc/ssl/private-ca/corporate-root.pem"

# Only the developer tool reads this — a run gets its password from the
# configuration a team filled in, never from the pod's environment.
FRED_SAMPLES_WEBDAV_PASSWORD=""
