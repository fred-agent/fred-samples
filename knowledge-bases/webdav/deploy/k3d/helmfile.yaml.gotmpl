# The WebDAV Knowledge Base on the local k3d instance of fred-deployment-factory,
# which runs
#   make k3d-app DIR=<fred-samples checkout>/knowledge-bases/webdav
# and passes the kube context and the namespace. deploy/k3d/build writes the
# image's values (K3D_IMAGE_VALUES); without it the chart's default image runs.
releases:
  - name: knowledge-base-webdav
    chart: ../../../../charts/knowledge-base
    values:
      - values.yaml
      {{- with env "K3D_IMAGE_VALUES" }}
      - {{ . | quote }}
      {{- end }}
